# Matches what the repository already uses: two-space indentation in shell,
# zsh, YAML and Markdown, LF everywhere (see .gitattributes), UTF-8 and a
# final newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
